# Copiar este archivo como .env (cp .env.example .env) y cambiar los valores.
# .env está en .gitignore: nunca se sube al repo.

# MySQL (Docker)
MYSQL_ROOT_PASSWORD=cambia_esto_root
MYSQL_DATABASE=vapor
MYSQL_USER=vapor
MYSQL_PASSWORD=cambia_esto
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306

# Servidor C++
VAPOR_HOST=0.0.0.0
VAPOR_PORT=8080
VAPOR_LOG_LEVEL=debug
# Genera uno con: openssl rand -base64 48
VAPOR_JWT_SECRET=cambiar_esto_por_un_secreto_largo
VAPOR_ACCESS_TOKEN_MIN=15
VAPOR_REFRESH_TOKEN_DAYS=30
VAPOR_MAX_UPLOAD_MB=10

# SeaweedFS (API compatible con S3)
S3_ENDPOINT=http://127.0.0.1:8333
S3_BUCKET=vapor-files
S3_ACCESS_KEY=vapor
S3_SECRET_KEY=cambia_esto

# Correo (en desarrollo, Mailpit lo recoge todo)
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_FROM=no-reply@vapor.local

# Caddy (solo en el servidor de pruebas / demo)
VAPOR_DOMAIN=localhost
